# Weather API (used by src/services/weatherService.js)
# Get a free key at https://openweathermap.org/api and paste it below.
# The service already falls back to clearly-labeled mock data if this is empty,
# so the app runs fine without it during development.
VITE_WEATHER_API_KEY=eaed4a077836683506acabfbb052cc9a

# OpenCage geocoding (for converting a typed address to lat/lng)
# https://opencagedata.com/
VITE_OPENCAGE_API_KEY=447942370e894c71ace26b7d346e597d

# Your existing backend base URL (Express API), once you connect it.
# services/propertyService.js reads this to switch from mock data to real fetch calls.
VITE_API_BASE_URL=http://localhost:5000/api
